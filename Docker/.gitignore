# macOS / editor noise
.DS_Store

# Local-only environment overrides
.env
.env.local

# Runtime bind-mounted data (keep directory placeholders)
data/**
!data/**/
!data/**/.gitkeep

# Solr assets synced from modules at runtime/build (keep placeholders)
solr/cores/**
!solr/cores/**/
!solr/cores/**/.gitkeep
solr/import/**
!solr/import/**/
!solr/import/**/.gitkeep
solr/jars/**
!solr/jars/**/
!solr/jars/**/.gitkeep

# Runtime logs and pid files
*.log
*.pid
# ...except the expected call logs of the contract tests
!tests/contract/snapshots/*.log

# PostgreSQL upgrade/rollback lock
.pg-upgrade.lock/

# Test tools downloaded by Docker/tests/run.sh (bats, shellcheck)
tests/.bin/
/tests/contract/snapshots/
