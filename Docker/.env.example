SERVICE_PREFIX=
# Port shift for a second installation on the same host: use a multiple of 1000.
# Offsets that move a port onto another service's default port (e.g. 10, 100) are rejected.
SERVICES_PORT_OFFSET=
# `up` asks for confirmation when other LA Referencia installations run on the host
# (interactive terminals only). Set to true to skip the question.
LR_ALLOW_OTHER_INSTANCES=false

# Maven profile for Java module builds
LR_BUILD_PROFILE=lareferencia

# External services configuration
# If SOLR_EXTERNAL_URL is set, the local Docker Solr container will not be started.
# Example: http://your-external-solr-host:8983/solr
SOLR_EXTERNAL_URL=

# Host IP address to bind the harvester service port (default: 127.0.0.1)
LR_IP_HARVESTER=

# PostgreSQL image. Empty = default of docker-compose.yml (postgres:17-alpine3.23).
# Servers with PostgreSQL 14 data can pin the old image until they migrate:
#   LR_POSTGRES_IMAGE=postgres:14.15-alpine
LR_POSTGRES_IMAGE=

# After a PostgreSQL major upgrade, the old cluster is kept for rollback. Once this
# many seconds have passed, the wizard offers to delete it (default 2592000 = 30 days).
LR_PG_LEGACY_RETENTION_SECONDS=2592000

# Build jars policy on container startup: smart|always|false
BUILD_ON_START=smart

# Build concurrency for frontend/backend components: false (sequential, CPU-safe) or true (parallel)
BUILD_PARALLEL=false

# Docker image cleanup after each build — only La Referencia images are touched.
# Images of previous builds of this installation kept besides the current one.
LR_IMAGE_KEEP_PREVIOUS=1

# Cloning the Java modules (githelper): attempts per run for modules whose clone
# failed (network resets), and the base delay in seconds between them.
GIT_CLONE_ATTEMPTS=3
GIT_CLONE_RETRY_DELAY=5

# Docker image downloads (compose build/up/pull): attempts when a download fails
# because of the network (timeout/reset), and the base delay in seconds between them.
DOCKER_NETWORK_ATTEMPTS=3
DOCKER_NETWORK_RETRY_DELAY=10

# Resource limits for Java Backend compilation (Maven container)
LR_JAVA_BUILD_CPUS=2
LR_JAVA_BUILD_MEMORY=2g
LR_JAVA_BUILD_OPTS="-Xmx1536m -XX:ActiveProcessorCount=2 -XX:ParallelGCThreads=2"

# Keep shell service container idle/running and execute commands via docker exec
SHELL_IDLE=true

# Optional modules enabled by default in Docker/docker.sh
DEV_MODULE_SOLR=on
DEV_MODULE_HARVESTER=on
DEV_MODULE_ENTITY_REST=off
DEV_MODULE_SHELL=off
DEV_MODULE_VUFIND=on
DEV_MODULE_ELASTIC=off
DEV_MODULE_WATCH=off

# VuFind checkout (used when ./vufind is missing)
VUFIND_REPO_URL=https://github.com/LA-Referencia-IOI/vufind
VUFIND_REF=v11.0.1

# VuFind theme (optional)
VUFIND_THEME=bootstrap5

# Developer gateway port (docker-dev.sh offsets this in isolated mode)
LR_PORT_GATEWAY=8088

# VuFind debug mode (default OFF)
VUFIND_ENV=production
VUFIND_SYSTEM_DEBUG=false
VUFIND_PHP_DISPLAY_ERRORS=0
VUFIND_PHP_DISPLAY_STARTUP_ERRORS=0
VUFIND_PHP_ERROR_REPORTING=E_ALL
VUFIND_PHP_HTML_ERRORS=0
