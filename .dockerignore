# Version control
.git
**/.git
.gitignore

# Docker runtime data, volumes, and backups
Docker/data
Docker/volume
Docker/backups
Docker_pre_restoration
Docker/.bin

# Node dependencies and build artifacts
**/node_modules
**/dist

# VuFind host checkout (mounted as volume at runtime)
vufind

# Maven target intermediate files across all modules
**/target/classes
**/target/test-classes
**/target/generated-sources
**/target/generated-test-sources
**/target/maven-archiver
**/target/maven-status
**/target/surefire-reports
**/target/antrun
**/target/reports
**/target/apidocs
**/target/*.original
**/target/*-sources.jar
**/target/*-javadoc.jar

# Temporary and log files
**/*.log
**/*.tar.gz
**/*.bak
**/*.tmp
.DS_Store
